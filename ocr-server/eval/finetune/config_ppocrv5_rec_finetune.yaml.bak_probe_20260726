# PP-OCRv5 mobile Korean rec — fine-tune config (PaddleX 3.x).
#
# Served model = korean_PP-OCRv5_mobile_rec  (main.py:1135, PaddleOCR 3.4.1 / PaddleX 3.4.3).
# This REPLACES the old v4-style `config_rec_finetune.yml`, which targeted the classic
# PaddleOCR `tools/train.py` + hand-written Architecture/Backbone/Head/Loss. That flow does
# NOT apply to this stack: on PaddleX 3.x the architecture is resolved from `Global.model`,
# so you MUST NOT hand-specify it. Official base copied from (verbatim, then re-pathed):
#   .venv/Lib/site-packages/paddlex/configs/modules/text_recognition/korean_PP-OCRv5_mobile_rec.yaml
#
# Prereq on the GPU box (this is the "training repo we don't have yet" from RECIPE step 0):
#   paddlex --install PaddleOCR        # pulls the training plugin/code
#
# Run (from ocr-server/):
#   1) validate dataset layout FIRST — PaddleX wants a dataset_dir, not a loose train.txt:
#   python -m paddlex --config eval/finetune/config_ppocrv5_rec_finetune.yaml -o Global.mode=check_dataset
#   2) fine-tune:
#   python -m paddlex --config eval/finetune/config_ppocrv5_rec_finetune.yaml -o Global.mode=train
#   3) evaluate on held-out test, then export to an inference dir the server can load.
#
# GATE (unchanged, RECIPE step 5): keep the new weights ONLY if domain test-acc ↑ AND the
# BASELINE_LOCK set does not regress (no forgetting). The corpus is smoke-scale today
# (train 226/val 28/test 28) — this config is READY but the DATA is not; run for real only
# after the corpus grows to thousands + a real held-out test.

Global:
  model: korean_PP-OCRv5_mobile_rec
  mode: train                       # override per step: check_dataset / train / evaluate / export
  dataset_dir: eval/finetune_corpus # = corpus root (run from ocr-server/). build_paddlex_dataset.py
                                    # puts train.txt/val.txt/test.txt + dict.txt here; crops resolve
                                    # via crops[_correct]/<hash>.jpg relative to this dir. Verify with
                                    # mode=check_dataset before training.
  device: gpu:0
  output: eval/finetune/output

CheckDataset:
  convert:
    enable: False
    src_dataset_type: null
  split:
    enable: False
    train_percent: null
    val_percent: null

Train:
  epochs_iters: 4                   # 실측(2026-07-23): 리키잉 92만 run val 정점=ep2(0.638)→ep3 하락.
                                    # 정점 ep2~3 + 여유1 = 4로 상한(≈8h). best_accuracy 자동저장이라
                                    # 상한은 시간만 정함(품질 무관). 마지막 에폭까지 계속 오르면 다시 올릴 것.
  batch_size: 64                    # T4(16GB)에서 rec 크롭(48x320) 여유. GPU 활용률 ↑ = 훨씬 빠름 (OOM 시 32)
  learning_rate: 0.0001             # ★ 파인튜닝은 작은 lr! 0.001 은 과격해서 pretrained 를 망가뜨림
                                    #   (val acc 하락 = 확인됨). warmup 도 줄여야(repo_apis korean config)
  pretrain_weight_path: https://paddle-model-ecology.bj.bcebos.com/paddlex/official_pretrained_model/korean_PP-OCRv5_mobile_rec_pretrained.pdparams
  resume_path: null
  log_interval: 20
  eval_interval: 1
  save_interval: 1

Evaluate:
  weight_path: "eval/finetune/output/best_accuracy/best_accuracy.pdparams"
  log_interval: 1

Export:
  weight_path: "eval/finetune/output/best_accuracy/best_accuracy.pdparams"
